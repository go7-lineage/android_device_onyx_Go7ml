# init.go7ml.drm.sh: finds the onyx-epd DRM card in sysfs, sets vendor.hwc.drm.device
type go7ml_drm_card, domain;
type go7ml_drm_card_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(go7ml_drm_card)

allow go7ml_drm_card vendor_shell_exec:file rx_file_perms;
allow go7ml_drm_card vendor_toolbox_exec:file rx_file_perms;
# /sys/class/drm/cardN/device/driver links
r_dir_file(go7ml_drm_card, sysfs)
set_prop(go7ml_drm_card, vendor_hwc_drm_prop)
