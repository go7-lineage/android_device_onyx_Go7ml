# init.go7ml.rc maps persist.vendor.eink_shim.* to the onyx-epd UI policy
allow vendor_init sysfs_sepdc:file w_file_perms;
get_prop(vendor_init, vendor_eink_shim_mode_prop)
# and persist.vendor.go7fl.ct to the frontlight's warmth
get_prop(vendor_init, vendor_frontlight_prop)
# init.go7ml.rc sets vendor.usb.controller itself (dragonboard has a script for it)
set_prop(vendor_init, vendor_usb_prop)
