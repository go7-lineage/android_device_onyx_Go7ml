From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Go7 port <go7-port@example.invalid>
Date: Thu, 26 Nov 2026 20:00:10 +0000
Subject: [PATCH] sepolicy: add frontlight_service

The frontlight service in system_server backs Onyx's DeviceController,
which KOReader and other Onyx apps call by reflection; any app may look
it up, as on stock. It sets the warmth through persist.vendor.go7fl.ct,
so system_server joins system_writes_vendor_properties_violators like
platform_app does for the QS warmth slider: under compatible_property,
the coredomain property_service neverallow otherwise covers the vendor
property. The fuzzer bindings list every service_contexts name.
---
 build/soong/service_fuzzer_bindings.go | 1 +
 private/service.te                     | 1 +
 private/service_contexts               | 1 +
 private/system_server.te               | 3 +++
 4 files changed, 6 insertions(+)

diff --git a/build/soong/service_fuzzer_bindings.go b/build/soong/service_fuzzer_bindings.go
index dd83ae0..b798e90 100644
--- a/build/soong/service_fuzzer_bindings.go
+++ b/build/soong/service_fuzzer_bindings.go
@@ -332,6 +332,7 @@ var (
 		"fingerprint":                                                          EXCEPTION_NO_FUZZER,
 		"feature_flags":                                                        EXCEPTION_NO_FUZZER,
 		"font":                                                                 EXCEPTION_NO_FUZZER,
+		"frontlight":                                                           EXCEPTION_NO_FUZZER,
 		"android.hardware.fingerprint.IFingerprintDaemon": EXCEPTION_NO_FUZZER,
 		"game":                                   EXCEPTION_NO_FUZZER,
 		"gfxinfo":                                EXCEPTION_NO_FUZZER,
diff --git a/private/service.te b/private/service.te
index 7e738f8..c10dee0 100644
--- a/private/service.te
+++ b/private/service.te
@@ -17,6 +17,7 @@ type dynamic_system_service,         system_api_service, system_server_service,
 type feature_flags_service,          app_api_service, system_server_service, service_manager_type;
 type file_service,                   app_api_service, ephemeral_app_api_service, system_server_service, service_manager_type;
 type fwk_devicestate_service, system_server_service, service_manager_type;
+type frontlight_service,             app_api_service, system_server_service, service_manager_type;
 type gsi_service,                    service_manager_type;
 type incidentcompanion_service,      app_api_service, system_api_service, system_server_service, service_manager_type;
 type logcat_service,                 system_server_service, service_manager_type;
diff --git a/private/service_contexts b/private/service_contexts
index de00043..e075c6f 100644
--- a/private/service_contexts
+++ b/private/service_contexts
@@ -322,6 +322,7 @@ file_integrity                            u:object_r:file_integrity_service:s0
 file                                      u:object_r:file_service:s0
 fingerprint                               u:object_r:fingerprint_service:s0
 font                                      u:object_r:font_service:s0
+frontlight                                u:object_r:frontlight_service:s0
 android.hardware.fingerprint.IFingerprintDaemon u:object_r:fingerprintd_service:s0
 game                                      u:object_r:game_service:s0
 gfxinfo                                   u:object_r:gfxinfo_service:s0
diff --git a/private/system_server.te b/private/system_server.te
index 355e5b9..4d6b5d5 100644
--- a/private/system_server.te
+++ b/private/system_server.te
@@ -1921,3 +1921,6 @@ set_prop(system_server, thermal_profile_prop)
 # wrapfd device node and the wrapfds.
 neverallowxperm system_server wrapfd_device:chr_file ioctl ~{ WRAPFD_DEV_IOC_WRAP };
 neverallowxperm system_server system_server_wrapfd:anon_inode ioctl ~{ dma_buf_ioctls wrapfd_ioctls };
+
+typeattribute system_server system_writes_vendor_properties_violators;
+set_prop(system_server, vendor_frontlight_prop)
