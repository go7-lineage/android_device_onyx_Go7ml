# init.go7ml.logdump.sh: dmesg to the logdump partition (first-boot aid)
type go7ml_logdump, domain;
type go7ml_logdump_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(go7ml_logdump)

allow go7ml_logdump vendor_shell_exec:file rx_file_perms;
allow go7ml_logdump vendor_toolbox_exec:file rx_file_perms;
allow go7ml_logdump kernel:system syslog_read;
allow go7ml_logdump proc_uptime:file r_file_perms;
allow go7ml_logdump block_device:dir search;
allow go7ml_logdump go7ml_logdump_block_device:blk_file w_file_perms;
