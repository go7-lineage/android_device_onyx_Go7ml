diff --git a/core/java/android/onyx/hardware/DeviceController.java b/core/java/android/onyx/hardware/DeviceController.java
new file mode 100644
index 000000000..1a89a5dab
--- /dev/null
+++ b/core/java/android/onyx/hardware/DeviceController.java
@@ -0,0 +1,117 @@
+package android.onyx.hardware;
+
+import android.compat.annotation.UnsupportedAppUsage;
+import android.content.Context;
+import android.os.IBinder;
+import android.os.RemoteException;
+import android.os.ServiceManager;
+
+/** @hide */
+public final class DeviceController {
+    private static final String SERVICE = "frontlight";
+    private static final int LIGHT_TYPE_CTM_ALL = 4;
+    private static final int LIGHT_TYPE_CTM_TEMPERATURE = 6;
+    private static final int LIGHT_TYPE_CTM_BRIGHTNESS = 7;
+    private static final int MAX_LEVEL = 32;
+
+    private static IFrontlight sService;
+
+    private DeviceController() {
+    }
+
+    @UnsupportedAppUsage
+    public static int getLightValue(int type) {
+        return isLevelType(type) ? read(type) : 0;
+    }
+
+    @UnsupportedAppUsage
+    public static int getMaxLightValue(int type) {
+        return isLevelType(type) && service() != null ? MAX_LEVEL : 0;
+    }
+
+    @UnsupportedAppUsage
+    public static void setLightValue(int type, int value) {
+        if (isLevelType(type) && value >= 0 && value <= MAX_LEVEL) {
+            write(type, value);
+        }
+    }
+
+    @UnsupportedAppUsage
+    public static boolean closeFrontLight(int type) {
+        return type == LIGHT_TYPE_CTM_ALL && write(LIGHT_TYPE_CTM_BRIGHTNESS, 0);
+    }
+
+    @UnsupportedAppUsage
+    public static boolean openFrontLight(int type) {
+        return type == LIGHT_TYPE_CTM_ALL && service() != null;
+    }
+
+    @UnsupportedAppUsage
+    public static boolean isLightOn(int type) {
+        return type == LIGHT_TYPE_CTM_ALL && read(LIGHT_TYPE_CTM_BRIGHTNESS) > 0;
+    }
+
+    @UnsupportedAppUsage
+    public static boolean checkCTM() {
+        return true;
+    }
+
+    @UnsupportedAppUsage
+    public static boolean hasCTMBrightness(Context context) {
+        return true;
+    }
+
+    @UnsupportedAppUsage
+    public static boolean hasFLBrightness(Context context) {
+        return false;
+    }
+
+    private static boolean isLevelType(int type) {
+        return type == LIGHT_TYPE_CTM_BRIGHTNESS || type == LIGHT_TYPE_CTM_TEMPERATURE;
+    }
+
+    private static int read(int type) {
+        IFrontlight service = service();
+        if (service == null) {
+            return -1;
+        }
+        try {
+            return type == LIGHT_TYPE_CTM_TEMPERATURE ? service.getWarmth() : service.getBrightness();
+        } catch (RemoteException e) {
+            forget();
+            return -1;
+        }
+    }
+
+    private static boolean write(int type, int level) {
+        IFrontlight service = service();
+        if (service == null) {
+            return false;
+        }
+        try {
+            if (type == LIGHT_TYPE_CTM_TEMPERATURE) {
+                service.setWarmth(level);
+            } else {
+                service.setBrightness(level);
+            }
+            return true;
+        } catch (RemoteException e) {
+            forget();
+            return false;
+        }
+    }
+
+    private static synchronized IFrontlight service() {
+        if (sService == null) {
+            IBinder binder = ServiceManager.checkService(SERVICE);
+            if (binder != null) {
+                sService = IFrontlight.Stub.asInterface(binder);
+            }
+        }
+        return sService;
+    }
+
+    private static synchronized void forget() {
+        sService = null;
+    }
+}
