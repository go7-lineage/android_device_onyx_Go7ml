prebuilt_etc {
    name: "fstab.go7ml",
    src: "fstab.go7ml",
    vendor: true,
    ramdisk_available: true,
}

prebuilt_etc {
    name: "init.go7ml.rc",
    src: "init.go7ml.rc",
    sub_dir: "init/hw",
    vendor: true,
}

sh_binary {
    name: "init.go7ml.drm.sh",
    src: "init.go7ml.drm.sh",
    vendor: true,
}

sh_binary {
    name: "set_bdaddr.sh",
    src: "set_bdaddr.sh",
    vendor: true,
}

sh_binary {
    name: "init.go7ml.wlanaddr.sh",
    src: "init.go7ml.wlanaddr.sh",
    vendor: true,
}

sh_binary {
    name: "init.go7ml.audio.sh",
    src: "init.go7ml.audio.sh",
    vendor: true,
}

prebuilt_etc {
    name: "ueventd.go7ml.rc",
    filename: "ueventd.rc",
    src: "ueventd.go7ml.rc",
    vendor: true,
}
