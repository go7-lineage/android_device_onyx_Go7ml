diff --git a/services/core/java/com/android/server/frontlight/FrontlightLevels.java b/services/core/java/com/android/server/frontlight/FrontlightLevels.java
new file mode 100644
index 000000000..c9f51a31c
--- /dev/null
+++ b/services/core/java/com/android/server/frontlight/FrontlightLevels.java
@@ -0,0 +1,40 @@
+package com.android.server.frontlight;
+
+final class FrontlightLevels {
+    static final int MAX_LEVEL = 32;
+
+    private static final double HLG_A = 0.17883277;
+    private static final double HLG_B = 0.28466892;
+    private static final double HLG_C = 0.55991073;
+
+    private FrontlightLevels() {
+    }
+
+    static float toBrightness(int level) {
+        if (level <= 0) {
+            return 0f;
+        }
+        if (level >= MAX_LEVEL) {
+            return 1f;
+        }
+        return (float) hlgInverse((level + 0.5) / MAX_LEVEL);
+    }
+
+    static int toLevel(float brightness) {
+        if (brightness <= 0f) {
+            return 0;
+        }
+        if (brightness >= 1f) {
+            return MAX_LEVEL;
+        }
+        return Math.min(MAX_LEVEL, (int) Math.floor(MAX_LEVEL * hlg(brightness)));
+    }
+
+    private static double hlg(double e) {
+        return e <= 1.0 / 12 ? Math.sqrt(3 * e) : HLG_A * Math.log(12 * e - HLG_B) + HLG_C;
+    }
+
+    private static double hlgInverse(double v) {
+        return v <= 0.5 ? v * v / 3 : (Math.exp((v - HLG_C) / HLG_A) + HLG_B) / 12;
+    }
+}
diff --git a/services/core/java/com/android/server/frontlight/FrontlightService.java b/services/core/java/com/android/server/frontlight/FrontlightService.java
new file mode 100644
index 000000000..b094f0036
--- /dev/null
+++ b/services/core/java/com/android/server/frontlight/FrontlightService.java
@@ -0,0 +1,98 @@
+package com.android.server.frontlight;
+
+import android.content.Context;
+import android.hardware.display.DisplayManager;
+import android.onyx.hardware.IFrontlight;
+import android.os.Binder;
+import android.os.SystemProperties;
+import android.util.Slog;
+import android.view.Display;
+
+import com.android.server.SystemService;
+
+public final class FrontlightService extends SystemService {
+    private static final String TAG = "FrontlightService";
+    private static final String SERVICE = "frontlight";
+    private static final String WARMTH_PROP = "persist.vendor.go7fl.ct";
+
+    private boolean mWarned;
+
+    public FrontlightService(Context context) {
+        super(context);
+    }
+
+    @Override
+    public void onStart() {
+        publishBinderService(SERVICE, new IFrontlight.Stub() {
+            @Override
+            public int getBrightness() {
+                return readBrightness();
+            }
+
+            @Override
+            public void setBrightness(int level) {
+                writeBrightness(level);
+            }
+
+            @Override
+            public int getWarmth() {
+                int level = SystemProperties.getInt(WARMTH_PROP, 0);
+                return Math.max(0, Math.min(FrontlightLevels.MAX_LEVEL, level));
+            }
+
+            @Override
+            public void setWarmth(int level) {
+                writeWarmth(level);
+            }
+        });
+    }
+
+    private int readBrightness() {
+        final long token = Binder.clearCallingIdentity();
+        try {
+            return FrontlightLevels.toLevel(displayManager().getBrightness(Display.DEFAULT_DISPLAY));
+        } catch (RuntimeException e) {
+            warn("cannot read the brightness", e);
+            return 0;
+        } finally {
+            Binder.restoreCallingIdentity(token);
+        }
+    }
+
+    private void writeBrightness(int level) {
+        if (level < 0 || level > FrontlightLevels.MAX_LEVEL) {
+            return;
+        }
+        final long token = Binder.clearCallingIdentity();
+        try {
+            displayManager().setBrightness(Display.DEFAULT_DISPLAY,
+                    FrontlightLevels.toBrightness(level));
+        } catch (RuntimeException e) {
+            warn("cannot set the brightness", e);
+        } finally {
+            Binder.restoreCallingIdentity(token);
+        }
+    }
+
+    private void writeWarmth(int level) {
+        if (level < 0 || level > FrontlightLevels.MAX_LEVEL) {
+            return;
+        }
+        try {
+            SystemProperties.set(WARMTH_PROP, Integer.toString(level));
+        } catch (RuntimeException e) {
+            warn("cannot set " + WARMTH_PROP, e);
+        }
+    }
+
+    private DisplayManager displayManager() {
+        return getContext().getSystemService(DisplayManager.class);
+    }
+
+    private synchronized void warn(String what, RuntimeException e) {
+        if (!mWarned) {
+            mWarned = true;
+            Slog.w(TAG, what, e);
+        }
+    }
+}
